SERVER_NODE=node1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=aidensrocks
DB_HOST=192.168.1.57
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=aidensrocks
DB_IPS=192.168.1.57,192.168.1.47

KEEPALIVED_INTERFACE=eth0                   # Proxmox host interface
KEEPALIVED_PRIORITY=101                     # Node1 = 101 (primary), Node2 = 100 (secondary)
KEEPALIVED_PASSWORD=
KEEPALIVED_VIRTUAL_IPS=192.168.1.40/24
KEEPALIVED_UNICAST_PEERS="#PYTHON2BASH:['192.168.1.47']" #IP address of other node
KEEPALIVED_STATE=MASTER                     # Node1 = MASTER, Node2 = BACKUP

# Run every 6 hours
BACKUP_INTERVAL=6

# Node-specific offset (set different per node!)
# Node1 = 0, Node2 = 10800 (3h in seconds)
BACKUP_OFFSET=0

#Cloudflare (dns thing)
CLOUDFLARE_API_TOKEN=
DOMAINS=aidensrocks.com,www.aidensrocks.com
PROXIED=false
UPDATE_INTERVAL=30
QUIET=1
IP6_PROVIDER=none

# Account auth (server/src/routes/auth.js + middleware/requireAuth.js).
# The admin signs in with a DB account (create it with `npm run create-admin`
# in server/) -- ADMIN_USERNAME/ADMIN_PASSWORD are no longer used.
# Generate your own JWT_SECRET per deployment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be identical across every node in the cluster.
JWT_SECRET=change-me-generate-a-random-hex-string
JWT_EXPIRES_IN=90d
# Public base URL used for links in account emails (verify / reset / rock moved).
PUBLIC_SITE_URL=https://example.com

# Outbound email (server/src/utils/sendEmail.js) — Gmail account + app password.
EMAIL_USER=
EMAIL_PASSWORD=
# Optional: send through your own domain's SMTP provider instead of Gmail
# (much better inbox placement -- see data/ai-build-docs/email-deliverability/).
# SMTP_HOST=smtp.example-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Aiden's Rocks <hello@example.com>   (no quotes -- docker compose rejects them here)
# EMAIL_REPLY_TO=AidensRocks.AAA@gmail.com
# Each email's own Sender / Reply-To / Send To is set in Admin -> Page Details;
# the two above are only defaults. Last-resort recipient for an upload-failure
# alert whose template can't be read (e.g. the database is down):
# ADMIN_ALERT_EMAIL=AidensRocks.AAA@gmail.com

# Reverse geocoding for Journey admin (country/state) -- opencagedata.com key.
OPENCAGE_API_KEY=
