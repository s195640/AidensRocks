# syntax=docker/dockerfile:1
# Build stage
FROM node:18 AS build
WORKDIR /app
COPY client/package*.json client/.npmrc ./
# GITHUB_TOKEN is mounted as a BuildKit secret (see docker-compose-prod.yml's
# `secrets:`), not an ARG/ENV — that keeps it out of the image's layer
# history entirely. .npmrc (copied above) is what actually points the
# @s195640 scope at GitHub Packages and reads this env var; npm needs no
# other config to pick it up.
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN npm install
COPY client .
# vite.config.js bakes the site version into the build from ../VERSION.
COPY VERSION /VERSION
RUN npm run build
# Hidden source maps (vite.config.js) move out of the public web root into
# /sourcemaps/<version>/assets, for readable error stack traces on the admin
# dashboard. They're never served.
RUN mkdir -p "/sourcemaps/$(cat /VERSION)/assets"  && find dist -name '*.map' -exec mv {} "/sourcemaps/$(cat /VERSION)/assets/" \;

# Production stage (static file server)
FROM nginx:stable-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /sourcemaps /sourcemaps
COPY ./data/docker/client-entrypoint/40-copy-sourcemaps.sh /docker-entrypoint.d/40-copy-sourcemaps.sh
RUN chmod +x /docker-entrypoint.d/40-copy-sourcemaps.sh
COPY ./data/nginx/nginx.conf /etc/nginx/nginx.conf
